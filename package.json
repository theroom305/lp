{
  "name": "room305-lp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "pnpm sync:buildings && pnpm verify:assets",
    "build": "pnpm verify:claims && pnpm verify:claims:db && next build",
    "start": "next start",
    "sync:buildings": "tsx scripts/sync-building-registry.ts",
    "ambient:generate": "tsx scripts/generate-ambient-batch.ts",
    "ambient:promote": "tsx scripts/promote-ambient-picks.ts",
    "ambient:probe": "tsx scripts/probe-image-capabilities.ts",
    "ambient:score": "tsx scripts/score-image-quality.ts",
    "ambient:calibration-gallery": "tsx scripts/generate-calibration-gallery.ts",
    "ambient:final-review": "tsx scripts/generate-final-review.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint",
    "verify:claims": "node scripts/verify-public-claims.mjs",
    "verify:claims:db": "node scripts/verify-disallowed-claims-db.mjs",
    "verify:assets": "tsx scripts/verify-assets.ts",
    "claims:sync-db": "node scripts/sync-disallowed-claims-db.mjs",
    "db:push": "drizzle-kit push",
    "db:introspect": "drizzle-kit introspect"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.53.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "15.5.18",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.12.0",
    "pino": "^10.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5",
    "yaml": "^2.9.0"
  }
}
